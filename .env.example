APP_NAME=Portfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The public URL of your site. Canonical URLs, the sitemap, llms.txt and JSON-LD are built from it.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Portfolio
# =============================================================================
# Your identity. Everything else (bio, projects, posts, skills, experience,
# avatar, resume, social links) is edited in the admin panel at /admin.

PORTFOLIO_OWNER_NAME="Alex Morgan"

# Shown after "Hi, I'm {name} —" on the home page. Wrap a phrase in *asterisks*
# to give it a hand-drawn marker highlight. The asterisks are stripped everywhere else.
PORTFOLIO_HEADLINE="a Laravel developer who builds with *AI*"

# The home page intro, also used as the home page meta and social description.
PORTFOLIO_TAGLINE="My corner of the internet: a portfolio you can talk to. Ask my AI anything about my work."

# Used in the AI assistant's instructions. Defaults to APP_URL.
PORTFOLIO_SITE_URL="${APP_URL}"

# How the chat assistant introduces itself.
PORTFOLIO_ASSISTANT_NAME="AI assistant"

# The theme first-time visitors see: "light" (warm paper) or "dark".
# Visitors can switch with the toggle in the navbar.
PORTFOLIO_DEFAULT_THEME=light

# Optional link to your fork's source code, shown in the footer.
PORTFOLIO_SOURCE_URL=

# Comma-separated emails allowed to sign in to /admin. Anyone else is denied.
# `php artisan db:seed` creates admin@example.com / "password" outside production.
PORTFOLIO_ADMIN_EMAILS=admin@example.com

# =============================================================================
# AI chat
# =============================================================================
# The provider and API key stay on the server; visitors only talk to Livewire.
# Providers and their keys are configured in config/ai.php (laravel/ai). To use
# another provider, set AI_PROVIDER, its API key and a matching model, e.g.
# AI_PROVIDER=openai, OPENAI_API_KEY=..., PORTFOLIO_CHAT_MODEL=<an OpenAI model>.

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Overrides AI_PROVIDER for the chat only.
# PORTFOLIO_CHAT_PROVIDER=anthropic
PORTFOLIO_CHAT_MODEL=claude-haiku-5-5
# Seconds to wait for the provider before showing a friendly error.
PORTFOLIO_CHAT_TIMEOUT=30

# Cost and abuse limits, applied per visitor (by IP).
PORTFOLIO_CHAT_MAX_MESSAGE_LENGTH=500
PORTFOLIO_CHAT_MAX_TURNS=20
PORTFOLIO_CHAT_RATE_LIMIT_PER_MINUTE=10
PORTFOLIO_CHAT_RATE_LIMIT_PER_DAY=50

# =============================================================================
# Contact form
# =============================================================================
# Messages allowed per visitor (by IP) within the decay window.
PORTFOLIO_CONTACT_RATE_LIMIT=3
PORTFOLIO_CONTACT_RATE_LIMIT_DECAY_MINUTES=10

# =============================================================================
# SEO & AI discoverability
# =============================================================================
# AI search bots (ChatGPT search, Claude, Perplexity...) are always allowed so
# your site can be cited. Set to false to block AI *training* crawlers
# (GPTBot, ClaudeBot, Google-Extended, CCBot...) in /robots.txt.
PORTFOLIO_ALLOW_AI_TRAINING=true

# Fallback social share image. Uploading a share image in /admin/about overrides it.
PORTFOLIO_DEFAULT_OG_IMAGE=/og-image.png
